{
	"name": "Python 3 Backend",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
	
	// 親ディレクトリをマウント
	"workspaceFolder": "/workspaces/meiwa-product/backend",
	"workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces/meiwa-product,type=bind",
	
	"postCreateCommand": "pip3 install --user -r requirements.lock",
	
	"forwardPorts": [8000],
	
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance"
			]
		}
	}
}